# Configuration File Instructions
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. The .env file is automatically loaded by ConfigManager
# 4. URLs are loaded from config.yml (committed to Git)
# 5. Do not use 'export' statements - dotenv-java handles this automatically

# LambdaTest credentials (if using LambdaTest for cloud testing)
LT_USERNAME=your-lambda-username
LT_ACCESS_KEY=your-lambda-access-key

# Test1 Site Credentials
TEST1_SITE_URL=your-site-url
TEST1_API_BASE_URI=your-site-api-url
TEST1_USERNAME=your-email@example.com
TEST1_PASSWORD=your-password
TEST1_API_KEY=your-api-key

# Chrislibhi-test Site Credentials
CHRISLIBHI_TEST_SITE_URL=your-site-url
CHRISLIBHI_TEST_API_BASE_URI=your-site-api-url
CHRISLIBHI_TEST_USERNAME=your-email@example.com
CHRISLIBHI_TEST_PASSWORD=your-password
CHRISLIBHI_TEST_API_KEY=your-api-key

# Add more sites as needed following the pattern:
# {SITE_NAME}_USERNAME=your-email@example.com
# {SITE_NAME}_PASSWORD=your-password
# {SITE_NAME}_API_KEY=your-api-key