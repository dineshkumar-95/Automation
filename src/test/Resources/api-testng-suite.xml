<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="API Test Suite" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.AnnotationTransformer"/>
    </listeners>

    <!-- API Tests - No browser required -->
    <test name="CustomerAPITests">
        <parameter name="apiBaseUrl" value="https://dinesh-kumar-test.chargebee.com"/>
        <classes>
            <class name="api.tests.CustomerApiTest"/>
        </classes>
    </test>
</suite>
